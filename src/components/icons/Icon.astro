---
import { iconPaths, type IconName } from "@/components/icons/paths";

interface Props {
  name: IconName;
  /** 1 辺のサイズ（px）。Tailwind の w-N h-N ではなく数値で受ける */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const paths = iconPaths[name];
---

{/* SVG の path データはここ1か所に集約する（複数ファイルへの重複定義を避ける） */}
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
