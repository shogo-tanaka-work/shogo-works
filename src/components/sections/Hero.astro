---
import Button from "@/components/ui/Button.astro";
---

<section class="min-h-[80vh] flex items-center pt-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <!-- Profile Image -->
      <div class="flex-shrink-0">
        <div class="relative w-40 h-40 md:w-52 md:h-52 overflow-hidden border border-border">
                <img
            src="/assets/images/profile.jpg"
            alt="田中 省伍"
            class="w-full h-full object-cover"
            style="object-position: center 25%;"
            loading="eager"
          />
        </div>
      </div>

      <!-- Text Content -->
      <div class="flex-1 text-center md:text-left">
        <p class="text-sm font-medium text-primary mb-3 tracking-wide uppercase font-mono">
          Freelance AI Engineer & Instructor
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-4">
          <span class="text-foreground">田中 省伍</span>
        </h1>

        <p class="text-xl sm:text-2xl font-medium mb-6">
          <span class="text-primary">AI活用と開発</span>
          <span class="text-muted-foreground"> を、</span>
          <br class="sm:hidden" />
          <span class="text-foreground">現場で手を動かしながら伴走する</span>
        </p>

        <p class="text-muted-foreground leading-relaxed mb-8 max-w-lg mx-auto md:mx-0">
          AIベンチャー企業との PoC を1年以上継続中、延べ100名以上への指導実績。
          個人へのマンツーマンサポートと、企業向けのアプリ開発・講師登壇を行っています。
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <Button href="/contact" size="lg">
            無料で相談する
            <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </Button>
          <Button href="/portfolio" variant="outline" size="lg">
            実績を見る
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
