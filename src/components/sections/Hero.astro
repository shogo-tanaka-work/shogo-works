---
import Button from "@/components/ui/Button.astro";
---

{/* 屋号はヘッダーで既出のため、FVでは氏名・顔写真を出さず提供価値だけを提示する */}
<section class="min-h-[70vh] flex items-center pt-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-medium text-primary mb-4 tracking-wide uppercase font-mono">
        Software Engineer &amp; AI Instructor
      </p>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.25] mb-6"
      >
        <span class="text-foreground">手を動かせる人が、</span>
        <br />
        <span class="text-foreground">設計から運用、</span>
        <br />
        <span class="text-primary">社内の定着</span><span class="text-foreground"
          >までやり切る。</span
        >
      </h1>

      <p class="jp-phrase text-lg text-muted-foreground leading-relaxed mb-10 max-w-2xl">
        開発歴5年以上のエンジニアです。開発チームへの参画・受託開発を主軸に、AI活用の指導も行います。
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="/contact" size="lg">
          無料で相談する
          <svg
            class="ml-2 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>
        <Button href="/portfolio" variant="outline" size="lg"> 実績を見る </Button>
      </div>
    </div>
  </div>
</section>
