---
import { stats } from "@/data";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
---

{/* 数字だけでは何の実績か伝わらないため、見出しを持たせて2行グリッドで読ませる */}
<Section id="stats">
  <SectionHeader
    eyebrow="Record"
    title="実績・数字"
    subtitle="開発と指導の両方を継続してきた実績です。"
  />

  <dl
    class="grid grid-cols-1 gap-x-10 gap-y-8 border-y border-border py-10 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      stats.map((stat) => (
        <div class="min-w-0">
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <p class="text-3xl font-bold text-foreground">{stat.value}</p>
            <p class="mt-1 text-sm font-medium text-foreground">{stat.label}</p>
            {stat.description && (
              <p class="mt-1 text-sm text-muted-foreground">
                {stat.description}
              </p>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
