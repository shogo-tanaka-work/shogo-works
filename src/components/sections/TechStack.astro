---
import { techStack } from "@/data";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import TechIcon from "@/components/ui/TechIcon.astro";
---

<Section id="tech-stack">
  <SectionHeader
    eyebrow="Tech Stack"
    title="取り扱い技術"
    subtitle="領域ごとの代表的な技術です。習熟度を含む一覧はスキルページに掲載しています。"
  />

  <div class="divide-y divide-border border-y border-border">
    {
      techStack.map((category) => (
        <div class="py-6">
          <h3 class="mb-4 text-sm font-semibold tracking-wider text-muted-foreground">
            {category.label}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {category.items.map((tech) => (
              <li class="inline-flex items-center gap-2 border border-border px-3 py-1.5 text-sm text-foreground">
                <TechIcon name={tech.name} size={18} />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-8">
    <a
      href="/skills"
      class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary transition-colors"
    >
      スキル一覧（レベル評価付き）を見る →
    </a>
  </div>
</Section>
