---
import { socialLinks } from "@/data";
import Icon from "@/components/icons/Icon.astro";
import type { IconName } from "@/components/icons/paths";
import NoteIcon from "@/components/icons/NoteIcon.astro";
import TiktokIcon from "@/components/icons/TiktokIcon.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 py-12">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <p class="text-lg font-bold text-foreground mb-2">shogoworks</p>
        <p class="text-sm text-muted-foreground">
          Web開発 × AI で、<br />ビジネスの課題を解決する
        </p>
      </div>

      <!-- Site Links -->
      <div>
        <p class="text-sm font-medium text-foreground mb-3">Site</p>
        <div class="flex flex-col gap-2">
          <a href="/about" class="text-sm text-muted-foreground hover:text-foreground transition-colors">About</a>
          <a href="/portfolio" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Portfolio</a>
          <a href="/skills" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Skills</a>
          <a href="/contact" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Contact</a>
        </div>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-sm font-medium text-foreground mb-3">Legal</p>
        <div class="flex flex-col gap-2">
          <a href="/terms-of-service" class="text-sm text-muted-foreground hover:text-foreground transition-colors">利用規約</a>
          <a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">プライバシーポリシー</a>
        </div>
      </div>

      <!-- Social -->
      <div>
        <p class="text-sm font-medium text-foreground mb-3">SNS</p>
        <div class="flex gap-3 flex-wrap">
          {socialLinks.map((link) => {
            if (link.comingSoon) {
              return (
                <div
                  class="w-9 h-9 rounded-[4px] bg-gray-100 flex items-center justify-center text-muted-foreground/40 cursor-default relative group"
                  aria-label={`${link.name} (Coming Soon)`}
                >
                  {link.icon === "note" && <NoteIcon class="w-4 h-4" />}
                  {link.icon === "youtube" && <Icon name="youtube" class="w-4 h-4" />}
                  {link.icon === "tiktok" && <TiktokIcon class="w-4 h-4" />}
                  <span class="absolute -bottom-5 text-[8px] text-muted-foreground/50 whitespace-nowrap">Soon</span>
                </div>
              );
            }
            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-[4px] bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors"
                aria-label={link.name}
              >
                <Icon name={link.icon as IconName} class="w-4 h-4" />
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 text-center">
      <p class="text-xs text-muted-foreground">
        &copy; {year} shogoworks. All rights reserved.
      </p>
    </div>
  </div>
</footer>
