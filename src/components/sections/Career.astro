---
import { careerExperiences } from "@/data";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Badge from "@/components/ui/Badge.astro";
---

<Section id="career">
  <SectionHeader eyebrow="Career" title="これまでの職務経歴" />

  {/* ドット付きタイムラインをやめ、期間を左に置いた行リストにする */}
  <ol class="flex flex-col divide-y divide-border border-y border-border">
    {
      careerExperiences.map((exp) => (
        <li class="grid grid-cols-1 gap-3 py-6 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8">
          <p class="text-sm text-muted-foreground tabular-nums">{exp.period}</p>

          <div class="min-w-0">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-semibold text-foreground leading-snug">
                  {exp.company}
                </h3>
                <p class="mt-0.5 text-sm text-primary">{exp.role}</p>
              </div>
              <div class="flex shrink-0 flex-wrap items-center gap-2">
                {exp.upcoming && <Badge variant="emerald">入社予定</Badge>}
                {exp.current && <Badge variant="emerald">現職</Badge>}
                <Badge variant="teal">{exp.employment}</Badge>
                {exp.teamSize && (
                  <Badge variant="default">チーム {exp.teamSize}</Badge>
                )}
              </div>
            </div>

            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
              {exp.summary}
            </p>

            <ul class="mt-3 space-y-1.5">
              {exp.highlights.map((item) => (
                <li class="flex gap-2 text-sm text-muted-foreground leading-relaxed">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-primary" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {exp.technologies.map((tech) => (
                <Badge variant="default">{tech}</Badge>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
