---
import { differences } from "@/data";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
---

<Section id="difference">
    <SectionHeader
    eyebrow="Why me"
    title="他社との違い"
      subtitle="開発の実務とAI活用の両方を一人で担うため、設計から運用・社内定着まで速く継続的に伴走できます。"
    />

    <div class="space-y-4">
      {
        differences.map((item, index) => (
          <div
            class:list={[
              "grid grid-cols-1 md:grid-cols-[7rem_1fr_1fr] gap-4 md:gap-6 items-stretch ",
              ``,
            ]}
          >
            <div class="flex items-center font-semibold text-foreground">
              {item.aspect}
            </div>

            <div class="bg-gray-50 border border-border p-5">
              <div class="text-xs text-muted-foreground mb-2">
                一般的な{item.counterpart}
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {item.others}
              </p>
            </div>

            <div class="bg-secondary border-primary/30 p-5">
              <div class="flex items-center gap-1.5 mb-2">
                <svg
                  class="w-4 h-4 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="text-xs font-medium text-primary">shogoworks</span>
              </div>
              <p class="text-sm text-foreground leading-relaxed">{item.mine}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>
