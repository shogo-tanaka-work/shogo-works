---
import { teachingExperience } from "@/data";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Badge from "@/components/ui/Badge.astro";
---

<Section id="teaching">
  <SectionHeader eyebrow="Teaching" title="講師実績・セミナー開催" />

  {/* 左右ジグザグのタイムラインをやめ、縦一列の行リストにする */}
  <ol class="flex flex-col divide-y divide-border border-y border-border">
    {
      teachingExperience.map((exp) => {
        const isClickable = exp.url && exp.url !== "#";
        const Wrapper = isClickable ? "a" : "div";
        const wrapperProps = isClickable
          ? { href: exp.url, target: "_blank", rel: "noopener noreferrer" }
          : {};

        return (
          <li>
            <Wrapper
              {...wrapperProps}
              class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-8"
            >
              <div class="text-sm">
                <p class="text-primary">{exp.organization}</p>
                <p class="mt-1 text-muted-foreground">{exp.period}</p>
              </div>

              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">
                    {exp.title}
                    {isClickable && (
                      <span class="ml-1 text-sm text-muted-foreground">↗</span>
                    )}
                  </h3>
                  <Badge variant="teal">{exp.type}</Badge>
                </div>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                  {exp.description}
                </p>
                <p class="mt-2 text-xs text-muted-foreground">
                  {exp.students}名指導
                </p>
              </div>
            </Wrapper>
          </li>
        );
      })
    }
  </ol>
</Section>
