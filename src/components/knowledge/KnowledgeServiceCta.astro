---
import type { ResolvedKnowledgeServiceLink } from "@/utils/serviceCta";

interface Props {
  links: ResolvedKnowledgeServiceLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="mt-16 pt-8 border-t border-border" aria-labelledby="knowledge-service-cta">
      <h2 id="knowledge-service-cta" class="text-xl font-bold text-foreground mb-2">
        この内容を業務に組み込みたい方へ
      </h2>
      <p class="text-sm text-muted-foreground mb-4">
        記事の内容を、自社の業務やご自身の開発に当てはめるところまでお手伝いしています。
      </p>
      <ul class="divide-y divide-border">
        {links.map((link) => (
          <li class="py-4">
            <a href={link.href} class="group block">
              <span class="block font-semibold text-foreground group-hover:text-primary transition-colors">
                {link.title} →
              </span>
              <span class="block text-sm text-muted-foreground mt-1">{link.reason}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="text-sm mt-2">
        <a href="/services" class="text-primary hover:underline">サービス一覧を見る</a>
      </p>
    </section>
  )
}
