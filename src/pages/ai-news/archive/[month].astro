---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import NewsCard from "@/components/ai-news/NewsCard.astro";
import ArchiveSidebar from "@/components/ai-news/ArchiveSidebar.astro";
import ArchiveSelect from "@/components/ai-news/ArchiveSelect.astro";
import {
  getAiNewsArchive,
  getAiNewsByMonth,
  getAiNewsSlug,
  type AiNewsArchiveMonth,
} from "@/utils/aiNews";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("aiNews");

  return getAiNewsArchive(entries).map((month) => ({
    params: { month: month.key },
    props: { month },
  }));
};

interface Props {
  month: AiNewsArchiveMonth;
}

const { month } = Astro.props;
const entries = await getCollection("aiNews");
const news = getAiNewsByMonth(entries, month.key);
const months = getAiNewsArchive(entries);
---

<BaseLayout
  title={`${month.label}のAI News | shogoworks`}
  description={`${month.label}に公開した主要AIツールの公式アップデート情報（${month.count}件）`}
>
  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <a
          href="/ai-news"
          class="text-sm text-teal-600 hover:text-teal-700 transition-colors"
        >
          ← AI News に戻る
        </a>
      </div>

      <SectionHeader
        title={month.label}
        subtitle={`${month.label}に公開したAIツールの公式アップデート ${month.count}件`}
      />

      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-10 lg:items-start">
        <div class="min-w-0">
          <div class="mb-8">
            <ArchiveSelect months={months} currentMonth={month.key} />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              news.map((entry, i) => (
                <div>
                  <NewsCard
                    title={entry.data.title}
                    toolLabel={entry.data.toolLabel}
                    date={entry.data.date}
                    summary={entry.data.summary}
                    tags={entry.data.tags}
                    status={entry.data.status}
                    href={`/ai-news/${entry.data.tool}/${getAiNewsSlug(entry.id)}`}
                    sourceUrl={entry.data.sourceUrl}
                  />
                </div>
              ))
            }
          </div>
        </div>

        <aside class="hidden lg:block lg:sticky lg:top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
          <ArchiveSidebar months={months} currentMonth={month.key} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
