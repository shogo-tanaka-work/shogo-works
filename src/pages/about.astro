---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutSection from "@/components/sections/About.astro";
import Stats from "@/components/sections/Stats.astro";
import Builds from "@/components/sections/Builds.astro";
import Approach from "@/components/sections/Approach.astro";
